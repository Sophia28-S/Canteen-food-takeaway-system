<html xmlns:o="urn:schemas-microsoft-com:office:office"
            xmlns:x="urn:schemas-microsoft-com:office:word"
            xmlns="http://www.w3.org/TR/REC-html40">

            <!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
            <html>
            <head>
                <meta http-equiv="Content-type" content="text/html;charset=utf-8" />
            </head>
            <body><h1>Database canteen_db</h1><h2>Table structure for table categories</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>category_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">category_name</td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr></table><h2>Table structure for table menu_items</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>item_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">category_id</td><td class="print">int</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">item_name</td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">description</td><td class="print">text</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">price</td><td class="print">decimal(10,2)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">image</td><td class="print">varchar(255)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">availability</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">stock</td><td class="print">int</td><td class="print">Yes</td><td class="print">0</td></tr></table><h2>Table structure for table orders</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>order_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">user_id</td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">slot_id</td><td class="print">int</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">pickup_time</td><td class="print">datetime</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">total_amount</td><td class="print">decimal(10,2)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">payment_method</td><td class="print">enum(&amp;#039;online&amp;#039;, &amp;#039;cash&amp;#039;)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">order_type</td><td class="print">enum(&amp;#039;now&amp;#039;, &amp;#039;scheduled&amp;#039;, &amp;#039;preorder&amp;#039;)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">status</td><td class="print">enum(&amp;#039;pending&amp;#039;, &amp;#039;accepted&amp;#039;, &amp;#039;preparing&amp;#039;, &amp;#039;ready&amp;#039;, &amp;#039;completed&amp;#039;, &amp;#039;cancelled&amp;#039;)</td><td class="print">Yes</td><td class="print">pending</td></tr><tr class="print-category"><td class="print">created_at</td><td class="print">timestamp</td><td class="print">Yes</td><td class="print">CURRENT_TIMESTAMP</td></tr><tr class="print-category"><td class="print">payment_status</td><td class="print">varchar(20)</td><td class="print">Yes</td><td class="print">pending</td></tr><tr class="print-category"><td class="print">accepted_at</td><td class="print">datetime</td><td class="print">Yes</td><td class="print">NULL</td></tr></table><h2>Table structure for table order_items</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>order_item_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">order_id</td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">item_id</td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">quantity</td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">price</td><td class="print">decimal(10,2)</td><td class="print">No</td><td class="print"></td></tr></table><h2>Table structure for table pickup_slots</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>slot_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">slot_time</td><td class="print">varchar(50)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">is_active</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr></table><h2>Table structure for table system_settings</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print">1</td></tr><tr class="print-category"><td class="print">system_name</td><td class="print">varchar(150)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">contact_email</td><td class="print">varchar(150)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">contact_phone</td><td class="print">varchar(20)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">ordering_enabled</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">cash_enabled</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">online_enabled</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">scheduled_enabled</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">tax_percentage</td><td class="print">decimal(5,2)</td><td class="print">Yes</td><td class="print">0.00</td></tr><tr class="print-category"><td class="print">service_charge</td><td class="print">decimal(5,2)</td><td class="print">Yes</td><td class="print">0.00</td></tr><tr class="print-category"><td class="print">currency_symbol</td><td class="print">varchar(5)</td><td class="print">Yes</td><td class="print">₹</td></tr><tr class="print-category"><td class="print">auto_cancel_minutes</td><td class="print">int</td><td class="print">Yes</td><td class="print">30</td></tr><tr class="print-category"><td class="print">max_items_per_order</td><td class="print">int</td><td class="print">Yes</td><td class="print">10</td></tr><tr class="print-category"><td class="print">low_stock_alert</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr><tr class="print-category"><td class="print">sound_alert</td><td class="print">tinyint(1)</td><td class="print">Yes</td><td class="print">1</td></tr></table><h2>Table structure for table time_slots</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>slot_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">start_time</td><td class="print">time</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">end_time</td><td class="print">time</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">capacity</td><td class="print">int</td><td class="print">Yes</td><td class="print">NULL</td></tr></table><h2>Table structure for table users</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>user_id</strong></em></td><td class="print">int</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">name</td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print"><strong>email</strong></td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">password</td><td class="print">varchar(255)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">role</td><td class="print">enum(&amp;#039;student&amp;#039;, &amp;#039;staff&amp;#039;, &amp;#039;admin&amp;#039;)</td><td class="print">Yes</td><td class="print">student</td></tr><tr class="print-category"><td class="print">created_at</td><td class="print">timestamp</td><td class="print">Yes</td><td class="print">CURRENT_TIMESTAMP</td></tr></table></body></html>